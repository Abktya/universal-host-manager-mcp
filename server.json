{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Abktya/universal-host-manager-mcp",
  "description": "Cross-platform FastMCP server for authenticated remote Linux/macOS host administration",
  "repository": {
    "url": "https://github.com/Abktya/universal-host-manager-mcp",
    "source": "github",
    "id": "1366574690"
  },
  "version": "0.1.12",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "universal-host-manager-mcp",
      "version": "0.1.12",
      "runtimeHint": "uvx",
      "transport": {
        "type": "streamable-http",
        "url": "http://{HOST}:{PORT}/mcp"
      },
      "environmentVariables": [
        {
          "name": "HOST",
          "description": "Interface to bind to",
          "default": "127.0.0.1"
        },
        {
          "name": "PORT",
          "description": "Port to listen on",
          "default": "8765"
        },
        {
          "name": "MCP_WORKSPACE_DIR",
          "description": "Directory that read_file/write_file/list_dir are restricted to",
          "isRequired": true
        },
        {
          "name": "AUTH0_DOMAIN",
          "description": "Auth0 tenant domain, e.g. your-tenant.eu.auth0.com",
          "isRequired": true
        },
        {
          "name": "AUTH0_CLIENT_ID",
          "description": "Auth0 application client ID",
          "isRequired": true
        },
        {
          "name": "AUTH0_CLIENT_SECRET",
          "description": "Auth0 application client secret",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "AUTH0_AUDIENCE",
          "description": "Auth0 API audience/identifier",
          "isRequired": true
        },
        {
          "name": "ALLOW_INSECURE_NO_AUTH",
          "description": "Set to true only for local-only testing without Auth0",
          "default": "false"
        }
      ]
    }
  ]
}
