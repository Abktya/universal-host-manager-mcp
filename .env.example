# Bind to loopback when a reverse proxy or tunnel runs on the same host.
HOST=127.0.0.1
PORT=8765
MCP_BASE_URL=https://mcp.example.com
MCP_WORKSPACE_DIR=/home/youruser/workspace

MAX_OUTPUT_CHARS=64000
DEFAULT_CMD_TIMEOUT=300
MAX_CMD_TIMEOUT=1800
MAX_READ_BYTES=5000000
LOG_LEVEL=INFO

AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=replace_me
AUTH0_CLIENT_SECRET=replace_me
AUTH0_AUDIENCE=https://mcp.example.com/

# Local development only. Never enable on a publicly reachable endpoint.
ALLOW_INSECURE_NO_AUTH=false
